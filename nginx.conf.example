# ==============================================================================
# Nginx Reverse Proxy Configuration for JJSOFT GLOBAL
# Place in /etc/nginx/sites-available/jjsoft-global and symlink to sites-enabled/
# ==============================================================================

# 1. Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name jjsoftglobal.com www.jjsoftglobal.com;

    # Let's Encrypt validation path
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 2. HTTPS Server Block
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name jjsoftglobal.com www.jjsoftglobal.com;

    # SSL Certificates (Managed automatically by Certbot)
    ssl_certificate /etc/letsencrypt/live/jjsoftglobal.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jjsoftglobal.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # Gzip Compression for Fast Page Speed
    gzip on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Next.js Static Chunks Caching (Immutable 1-Year Cache)
    location /_next/static/ {
        proxy_pass http://127.0.0.1:4985;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Public Static Assets
    location /assets/ {
        proxy_pass http://127.0.0.1:4985;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=86400";
    }

    # Main Reverse Proxy Route to Custom Docker Container Port (4985)
    location / {
        proxy_pass http://127.0.0.1:4985;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
        proxy_connect_timeout 60s;
    }
}
